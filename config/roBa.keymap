#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80
#define MOUSE 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mkp_input_listener { input-processors = <&zip_temp_layer 8 10000>; };

&trackball {
    automouse-layer = <8>;
    scroll-layers = <9>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        eisu {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <7 8>;
        };

        kana {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <1 2>;
        };

        To_layer10 {
            bindings = <&mo 10>;
            key-positions = <41 36>;
        };

        GUIcombo {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <18 19>;
        };

        ALTcombo {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <19 20>;
        };

        shiftCombo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        TO_MAC: TO_MAC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 3>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>;

            label = "TO_MAC";
        };

        TO_WIN: TO_WIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 3>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 4>,
                <&macro_wait_time 500>;

            label = "TO_WIN";
        };

        MAC_P: MAC_PW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp X &kp S &kp N4 &kp Q &kp H &kp N>;
            label = "MAC_PW";
        };

        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off MOUSE>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        hmr_left_AltGui: hmr_left_AltGui {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_LEFT_ALTGUI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 17 18 19 20 21 29 30 31 32 33>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmr_left_ShiftCrtl: hmr_left_ShiftCrtl {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_LEFT_SHIFTCRTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 17 18 19 20 21 29 30 31 32 33>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
        };

        lang_tapdance: lang_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&lt 6 LANGUAGE_2>, <&kp LANGUAGE_1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_mac {
            bindings = <
&kp Q                             &kp W                             &kp E                        &kp R                        &kp T                                                      &kp Y        &kp U  &lt 9 I    &kp O    &kp P
&hmr_left_ShiftCrtl RCTRL A       &hmr_left_ShiftCrtl LEFT_SHIFT S  &hmr_left_AltGui LEFT_ALT D  &hmr_left_AltGui LEFT_GUI F  &kp G                 &kp LS(LG(S))      &lt 10 SEMICOLON  &kp H        &kp J  &kp K      &kp L    &mt RCTRL MINUS
&hmr_left_ShiftCrtl LEFT_SHIFT Z  &kp X                             &kp C                        &kp V                        &kp B                 &kp ESC            &lt 6 DELETE      &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&none                             &kp LEFT_ALT                      &kp LEFT_GUI                 &lang_tapdance               &mt LEFT_SHIFT SPACE  &lt 7 TAB          &kp BACKSPACE     &lt 1 ENTER                             &kp LANGUAGE_1
            >;

            //            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        func_mac {
            bindings = <
&kp ESC        &kp LG(Z)      &kp LG(LS(NUMBER_5))  &kp LS(LG(NUMBER_4))  &kp LG(C)                           &kp F1       &kp HOME        &kp UP_ARROW    &kp END          &kp DELETE
&kp RCTRL      &kp LS(RCTRL)  &kp LEFT_GUI          &kp LEFT_ALT          &kp LG(LS(V))  &trans      &kp F13  &kp PAGE_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN
&kp LA(SPACE)  &kp RC(SPACE)  &kp LEFT_GUI          &kp RC(SPACE)         &trans         &MAC_P      &trans   &trans       &kp LS(SPACE)   &trans          &trans           &kp F11
&trans         &trans         &trans                &kp LANGUAGE_1        &trans         &trans      &trans   &trans                                                        &kp F12
            >;

            sensor-bindings = <&inc_dec_kp LANGUAGE_1 LANGUAGE_2>;
        };

        misc_mac {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        base_win {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                      &kp Y        &kp U  &lt 9 I    &kp O    &kp P
&mt RCTRL A       &kp S         &kp D         &kp F             &kp G                 &kp LS(LG(S))      &lt 10 SEMICOLON  &kp H        &kp J  &kp K      &kp L    &mt RCTRL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B                 &kp LEFT_GUI       &kp LEFT_ALT      &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt 6 LANGUAGE_1  &mt LEFT_SHIFT SPACE  &lt 7 TAB          &kp BACKSPACE     &lt 4 ENTER                             &kp DEL
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        func_win {
            bindings = <
&kp ESC        &kp LG(Z)      &kp LC(LG(LS(NUMBER_4)))  &kp LS(F10)    &trans                              &kp LS(F10)  &kp HOME        &kp UP_ARROW    &kp END          &kp DELETE
&kp RCTRL      &kp LS(RCTRL)  &kp LEFT_ALT              &kp LG(C)      &kp LG(LS(V))  &trans      &kp F13  &kp PAGE_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN
&kp LA(SPACE)  &kp RC(SPACE)  &kp LEFT_GUI              &kp RC(SPACE)  &trans         &trans      &trans   &trans       &kp LS(SPACE)   &trans          &trans           &kp F11
&trans         &trans         &trans                    &trans         &trans         &trans      &trans   &trans                                                        &kp F12
            >;

            sensor-bindings = <&inc_dec_kp LANGUAGE_1 LANGUAGE_2>;
        };

        misc_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        NUM_com {
            bindings = <
&kp F1                       &kp F2            &kp F3            &kp F4            &kp F5                                                         &kp F6            &kp F7            &kp F8            &kp F9            &kp F10
&mt RCTRL NUMBER_1           &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5      &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp NUMBER_6      &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9      &mt RCTRL NUMBER_0
&mt LEFT_SHIFT LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp F11                      &kp F12         &kp LG(NUMBER_6)  &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &kp LG(NUMBER_0)
&trans                       &trans            &trans            &trans            &trans            &trans                       &trans          &kp LEFT_GUI                                                            &kp PIPE
            >;
        };

        sym_com {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)      &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                      &kp LS(NUMBER_6)   &kp LS(NUMBER_7)      &kp LS(NUMBER_8)       &kp LS(NUMBER_9)   &kp LS(NUMBER_0)
&kp EQUAL         &kp LEFT_BRACKET      &kp SLASH         &kp MINUS         &kp LS(0x87)      &trans      &trans  &kp SEMICOLON      &kp SINGLE_QUOTE      &kp RIGHT_BRACKET      &kp BACKSLASH      &kp INT_YEN
&kp LS(EQUAL)     &kp LS(LEFT_BRACKET)  &kp LS(SLASH)     &kp LS(MINUS)     &trans            &trans      &trans  &kp LS(SEMICOLON)  &kp LS(SINGLE_QUOTE)  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp LS(INT_YEN)
&trans            &trans                &trans            &trans            &trans            &trans      &trans  &trans                                                                             &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &TO_MAC       &TO_WIN       &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
